# Postgres connection string (Neon or Supabase; Vercel can provision either)
DATABASE_URL="postgresql://user:password@host:5432/bedlisting?sslmode=require"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"

# Set to your MAIN site URL. The admin subdomain shares the same value.
# Local: http://localhost:3000   Production: https://bedlisting.com
NEXTAUTH_URL="http://localhost:3000"

# Paystack (dashboard.paystack.com > Settings > API Keys). Use the SECRET key. Never put it in frontend code.
PAYSTACK_SECRET_KEY=""

# Random secret that protects the daily cleanup job (Vercel sends it automatically).
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# Email (resend.com). Without a key, emails are only printed to the server log.
# EMAIL_FROM must use a domain you have verified in Resend, e.g. "bedlisting <notifications@bedlisting.com>"
RESEND_API_KEY=""
EMAIL_FROM=""
# Who gets admin alerts (new listing, ID, withdrawal, report). Comma separated. Empty = all admins.
ADMIN_NOTIFY_EMAIL=""

# Cloudinary (dashboard.cloudinary.com > Settings > API Keys)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Only used by `npm run db:seed-admin` (not needed on Vercel)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
